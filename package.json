{
  "name": "vuelix",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "node scripts/sync-pro.mjs && pnpm registry:build && vitepress dev docs",
    "build": "node scripts/sync-pro.mjs && pnpm registry:build && NODE_OPTIONS=--max-old-space-size=6144 vitepress build docs",
    "preview": "vitepress preview docs",
    "registry:build": "node scripts/build-registry.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:package": "pnpm --filter @vuelix/ui build",
    "pack:package": "pnpm --filter @vuelix/ui pack"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "motion-v": "^2.10.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "shadcn-vue": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.3.14"
  }
}
