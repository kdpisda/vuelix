{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "../../registry",
    "baseUrl": "../../registry",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["../../registry/**/*.ts", "../../registry/**/*.vue"]
}
