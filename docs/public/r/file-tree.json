{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "file-tree",
  "title": "File Tree",
  "description": "A keyboard-navigable file tree whose folders spring open and whose selection glides between rows.",
  "dependencies": [
    "motion-v"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/ui/file-tree/FileTree.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport type { FileTreeNode, FileTreeSlots } from './context'\nimport { useReducedMotion } from 'motion-v'\nimport { computed, nextTick, provide, ref, useId } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { FILE_TREE_KEY, isFolder, nodeId } from './context'\nimport FileTreeItem from './FileTreeItem.vue'\n\nconst props = withDefaults(defineProps<{\n  items: FileTreeNode[]\n  /** Accessible name for the tree. */\n  label?: string\n  /** Indentation per level, in pixels. */\n  indent?: number\n  class?: HTMLAttributes['class']\n}>(), {\n  label: 'Files',\n  indent: 16,\n})\n\n/** Id (path) of the selected node. */\nconst selected = defineModel<string | undefined>('selected', { default: undefined })\n/** Ids of the expanded folders. */\nconst expanded = defineModel<string[]>('expanded', { default: () => [] })\nconst emit = defineEmits<{ select: [node: FileTreeNode, id: string] }>()\n\nconst slots = defineSlots<FileTreeSlots>()\n\nconst root = ref<HTMLElement | null>(null)\nconst focused = ref<string | undefined>()\nconst reduced = useReducedMotion()\n\ninterface Row { id: string, node: FileTreeNode, parentId?: string }\n\n// Every node currently visible, in reading order — drives keyboard navigation.\nconst rows = computed(() => {\n  const out: Row[] = []\n  const walk = (nodes: FileTreeNode[], parentId?: string) => {\n    for (const node of nodes) {\n      const id = nodeId(node, parentId)\n      out.push({ id, node, parentId })\n      if (isFolder(node) && expanded.value.includes(id))\n        walk(node.children!, id)\n    }\n  }\n  walk(props.items)\n  return out\n})\n\n// Roving tabindex: exactly one item is tabbable.\nconst tabbable = computed(() => {\n  const ids = rows.value.map(r => r.id)\n  if (focused.value && ids.includes(focused.value))\n    return focused.value\n  if (selected.value && ids.includes(selected.value))\n    return selected.value\n  return ids[0]\n})\n\nfunction setExpanded(id: string, value: boolean) {\n  const has = expanded.value.includes(id)\n  if (value && !has)\n    expanded.value = [...expanded.value, id]\n  else if (!value && has)\n    expanded.value = expanded.value.filter(e => e !== id)\n}\n\nfunction activate(id: string, node: FileTreeNode) {\n  focus(id)\n  if (isFolder(node))\n    setExpanded(id, !expanded.value.includes(id))\n  if (!node.disabled) {\n    selected.value = id\n    emit('select', node, id)\n  }\n}\n\nasync function focus(id: string | undefined) {\n  if (!id)\n    return\n  focused.value = id\n  await nextTick()\n  const el = root.value?.querySelector<HTMLElement>(`[data-tree-id=\"${CSS.escape(id)}\"]`)\n  el?.focus()\n}\n\nfunction onKeydown(e: KeyboardEvent) {\n  const list = rows.value\n  const index = list.findIndex(r => r.id === tabbable.value)\n  const row = list[index]\n  if (!row)\n    return\n  const folder = isFolder(row.node)\n  const open = folder && expanded.value.includes(row.id)\n\n  switch (e.key) {\n    case 'ArrowDown':\n      focus(list[index + 1]?.id)\n      break\n    case 'ArrowUp':\n      focus(list[index - 1]?.id)\n      break\n    case 'Home':\n      focus(list[0]?.id)\n      break\n    case 'End':\n      focus(list.at(-1)?.id)\n      break\n    case 'ArrowRight':\n      if (folder && !open)\n        setExpanded(row.id, true)\n      else if (open)\n        focus(list[index + 1]?.id)\n      break\n    case 'ArrowLeft':\n      if (open)\n        setExpanded(row.id, false)\n      else\n        focus(row.parentId)\n      break\n    case 'Enter':\n    case ' ':\n      activate(row.id, row.node)\n      break\n    case '*': {\n      // Expand every sibling folder, per the WAI-ARIA tree pattern.\n      const siblings = list.filter(r => r.parentId === row.parentId && isFolder(r.node))\n      expanded.value = [...new Set([...expanded.value, ...siblings.map(r => r.id)])]\n      break\n    }\n    default: {\n      // Type-ahead: jump to the next visible item starting with the typed character.\n      if (e.key.length !== 1 || e.metaKey || e.ctrlKey || e.altKey)\n        return\n      const char = e.key.toLowerCase()\n      const ordered = [...list.slice(index + 1), ...list.slice(0, index + 1)]\n      const match = ordered.find(r => r.node.name.toLowerCase().startsWith(char))\n      if (!match)\n        return\n      focus(match.id)\n    }\n  }\n  e.preventDefault()\n}\n\nprovide(FILE_TREE_KEY, {\n  selected,\n  tabbable,\n  setFocused: (id) => { focused.value = id },\n  isExpanded: id => expanded.value.includes(id),\n  activate,\n  highlightId: `vx-file-tree-${useId()}`,\n  reduced,\n  indent: props.indent,\n})\n</script>\n\n<template>\n  <ul\n    ref=\"root\"\n    role=\"tree\"\n    :aria-label=\"props.label\"\n    :class=\"cn('m-0 w-full list-none p-1 font-mono text-sm', props.class)\"\n    @keydown=\"onKeydown\"\n  >\n    <FileTreeItem\n      v-for=\"(node, i) in props.items\"\n      :key=\"nodeId(node)\"\n      :node=\"node\"\n      :level=\"1\"\n      :posinset=\"i + 1\"\n      :setsize=\"props.items.length\"\n    >\n      <template v-if=\"slots.icon\" #icon=\"scope\">\n        <slot name=\"icon\" v-bind=\"scope\" />\n      </template>\n      <template v-if=\"slots.label\" #label=\"scope\">\n        <slot name=\"label\" v-bind=\"scope\" />\n      </template>\n    </FileTreeItem>\n  </ul>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/file-tree/FileTreeIcon.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport { cn } from '@/lib/utils'\n\nconst props = defineProps<{\n  name: string\n  folder?: boolean\n  open?: boolean\n}>()\n\n// Tints by file type, using chart tokens so they follow the theme.\nconst tints: Record<string, string> = {\n  ts: 'text-chart-2',\n  tsx: 'text-chart-2',\n  js: 'text-chart-4',\n  mjs: 'text-chart-4',\n  vue: 'text-chart-1',\n  json: 'text-chart-4',\n  css: 'text-chart-3',\n  html: 'text-chart-5',\n  md: 'text-muted-foreground',\n  png: 'text-chart-3',\n  jpg: 'text-chart-3',\n  svg: 'text-chart-3',\n}\n\nconst ext = computed(() => props.name.split('.').pop()?.toLowerCase() ?? '')\nconst kind = computed(() => {\n  if (['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'].includes(ext.value))\n    return 'image'\n  if (['md', 'mdx', 'txt'].includes(ext.value))\n    return 'text'\n  if (ext.value === 'json')\n    return 'data'\n  return 'code'\n})\n</script>\n\n<template>\n  <svg\n    :class=\"cn('size-4 shrink-0', props.folder ? 'text-chart-4' : (tints[ext] ?? 'text-muted-foreground'))\"\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    stroke-width=\"2\"\n    stroke-linecap=\"round\"\n    stroke-linejoin=\"round\"\n    aria-hidden=\"true\"\n  >\n    <template v-if=\"props.folder && props.open\">\n      <path d=\"M3 18V6.5A1.5 1.5 0 0 1 4.5 5h4l2 2.5h7A1.5 1.5 0 0 1 19 9v1.5\" />\n      <path d=\"M3 18 5.4 11.6A1.5 1.5 0 0 1 6.8 10.5H20.5a1 1 0 0 1 .95 1.3L19.6 17a1.5 1.5 0 0 1-1.4 1H3Z\" fill=\"currentColor\" fill-opacity=\"0.15\" />\n    </template>\n    <path\n      v-else-if=\"props.folder\"\n      d=\"M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h9A1.5 1.5 0 0 1 21 10v7.5A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5Z\"\n      fill=\"currentColor\"\n      fill-opacity=\"0.15\"\n    />\n    <template v-else>\n      <path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z\" />\n      <path d=\"M14 3v5h5\" />\n      <template v-if=\"kind === 'code'\">\n        <path d=\"m10 13-2 2 2 2\" />\n        <path d=\"m14 13 2 2-2 2\" />\n      </template>\n      <template v-else-if=\"kind === 'text'\">\n        <path d=\"M9 13h6M9 17h4\" />\n      </template>\n      <template v-else-if=\"kind === 'data'\">\n        <path d=\"M10 12.5c-1 0-1 .8-1 1.5s-.5 1-1 1c.5 0 1 .3 1 1s0 1.5 1 1.5M14 12.5c1 0 1 .8 1 1.5s.5 1 1 1c-.5 0-1 .3-1 1s0 1.5-1 1.5\" />\n      </template>\n      <template v-else>\n        <circle cx=\"10\" cy=\"12.5\" r=\"1.25\" />\n        <path d=\"m19 17-3.5-3.5L9 20\" />\n      </template>\n    </template>\n  </svg>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/file-tree/FileTreeItem.vue",
      "content": "<script setup lang=\"ts\">\nimport type { FileTreeNode, FileTreeSlots } from './context'\nimport { AnimatePresence, motion } from 'motion-v'\nimport { computed, inject } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { FILE_TREE_KEY, isFolder, nodeId } from './context'\nimport FileTreeIcon from './FileTreeIcon.vue'\n\nconst props = defineProps<{\n  node: FileTreeNode\n  parentId?: string\n  level: number\n  posinset: number\n  setsize: number\n}>()\n\nconst slots = defineSlots<FileTreeSlots>()\nconst ctx = inject(FILE_TREE_KEY)!\n\nconst id = computed(() => nodeId(props.node, props.parentId))\nconst folder = computed(() => isFolder(props.node))\nconst open = computed(() => folder.value && ctx.isExpanded(id.value))\nconst selected = computed(() => ctx.selected.value === id.value)\n\nconst spring = { type: 'spring', stiffness: 380, damping: 34 } as const\nconst transition = computed(() => (ctx.reduced.value ? { duration: 0 } : spring))\n</script>\n\n<template>\n  <li\n    role=\"treeitem\"\n    :data-tree-id=\"id\"\n    :aria-level=\"props.level\"\n    :aria-posinset=\"props.posinset\"\n    :aria-setsize=\"props.setsize\"\n    :aria-expanded=\"folder ? open : undefined\"\n    :aria-selected=\"selected\"\n    :aria-disabled=\"props.node.disabled || undefined\"\n    :tabindex=\"ctx.tabbable.value === id ? 0 : -1\"\n    class=\"outline-none [&:focus-visible>div]:ring-[3px] [&:focus-visible>div]:ring-inset [&:focus-visible>div]:ring-ring/50\"\n    @focus.self=\"ctx.setFocused(id)\"\n  >\n    <div\n      :class=\"cn(\n        'relative isolate flex cursor-pointer select-none items-center gap-1.5 rounded-md py-1 pr-2 text-sm transition-colors',\n        selected ? 'text-accent-foreground' : 'text-muted-foreground hover:bg-muted/60 hover:text-foreground',\n        props.node.disabled && 'cursor-default opacity-50',\n      )\"\n      :style=\"{ paddingLeft: `${(props.level - 1) * ctx.indent + 6}px` }\"\n      @click=\"ctx.activate(id, props.node)\"\n    >\n      <motion.span\n        v-if=\"selected\"\n        :layout-id=\"ctx.highlightId\"\n        aria-hidden=\"true\"\n        class=\"absolute inset-0 -z-10 rounded-md bg-accent ring-1 ring-border/60\"\n        :transition=\"transition\"\n      />\n      <motion.svg\n        v-if=\"folder\"\n        class=\"size-3.5 shrink-0 text-muted-foreground\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2.5\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n        :initial=\"false\"\n        :animate=\"{ rotate: open ? 90 : 0 }\"\n        :transition=\"transition\"\n      >\n        <path d=\"m9 18 6-6-6-6\" />\n      </motion.svg>\n      <span v-else class=\"size-3.5 shrink-0\" aria-hidden=\"true\" />\n      <slot name=\"icon\" :node=\"props.node\" :folder=\"folder\" :open=\"open\">\n        <FileTreeIcon :name=\"props.node.name\" :folder=\"folder\" :open=\"open\" />\n      </slot>\n      <span class=\"truncate\" :class=\"selected && 'font-medium'\">\n        <slot name=\"label\" :node=\"props.node\" :folder=\"folder\">{{ props.node.name }}</slot>\n      </span>\n    </div>\n\n    <AnimatePresence :initial=\"false\">\n      <motion.ul\n        v-if=\"open && props.node.children?.length\"\n        key=\"group\"\n        role=\"group\"\n        class=\"relative m-0 list-none overflow-hidden p-0 before:pointer-events-none before:absolute before:inset-y-0.5 before:left-[var(--guide)] before:w-px before:bg-muted-foreground/25\"\n        :style=\"{ '--guide': `${(props.level - 1) * ctx.indent + 6 + 7}px` }\"\n        :initial=\"{ height: 0, opacity: 0 }\"\n        :animate=\"{ height: 'auto', opacity: 1 }\"\n        :exit=\"{ height: 0, opacity: 0 }\"\n        :transition=\"transition\"\n      >\n        <FileTreeItem\n          v-for=\"(child, i) in props.node.children\"\n          :key=\"nodeId(child, id)\"\n          :node=\"child\"\n          :parent-id=\"id\"\n          :level=\"props.level + 1\"\n          :posinset=\"i + 1\"\n          :setsize=\"props.node.children.length\"\n        >\n          <template v-if=\"slots.icon\" #icon=\"scope\">\n            <slot name=\"icon\" v-bind=\"scope\" />\n          </template>\n          <template v-if=\"slots.label\" #label=\"scope\">\n            <slot name=\"label\" v-bind=\"scope\" />\n          </template>\n        </FileTreeItem>\n      </motion.ul>\n    </AnimatePresence>\n  </li>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/file-tree/context.ts",
      "content": "import type { InjectionKey, Ref } from 'vue'\n\nexport interface FileTreeNode {\n  /** File or folder name shown in the tree. */\n  name: string\n  /** Stable id. Defaults to the node's path, e.g. `src/components/Button.vue`. */\n  id?: string\n  /** Present (even if empty) for folders. */\n  children?: FileTreeNode[]\n  /** Disables selection; folders can still be expanded. */\n  disabled?: boolean\n}\n\nexport interface FileTreeContext {\n  selected: Ref<string | undefined>\n  /** The one item that is in the tab order (roving tabindex). */\n  tabbable: Readonly<Ref<string | undefined>>\n  setFocused: (id: string) => void\n  isExpanded: (id: string) => boolean\n  activate: (id: string, node: FileTreeNode) => void\n  highlightId: string\n  reduced: Ref<boolean>\n  indent: number\n}\n\nexport interface FileTreeSlots {\n  /** Replace the built-in file / folder icon. */\n  icon?: (props: { node: FileTreeNode, folder: boolean, open: boolean }) => any\n  /** Replace the node's label. */\n  label?: (props: { node: FileTreeNode, folder: boolean }) => any\n}\n\nexport const FILE_TREE_KEY: InjectionKey<FileTreeContext> = Symbol('vx-file-tree')\n\nexport function nodeId(node: FileTreeNode, parentId?: string) {\n  return node.id ?? (parentId ? `${parentId}/${node.name}` : node.name)\n}\n\nexport function isFolder(node: FileTreeNode) {\n  return Array.isArray(node.children)\n}\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/file-tree/index.ts",
      "content": "export type { FileTreeNode } from './context'\nexport { default as FileTree } from './FileTree.vue'\n",
      "type": "registry:ui"
    }
  ],
  "categories": [
    "components",
    "data-display"
  ],
  "type": "registry:ui"
}
