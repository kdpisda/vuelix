{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "availability-picker",
  "title": "Availability Picker",
  "description": "Weekly scheduler with day switches, animated time ranges and a drag-to-paint week grid.",
  "dependencies": [
    "motion-v"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/ui/availability-picker/AvailabilityGrid.vue",
      "content": "<script setup lang=\"ts\">\nimport type { AvailabilityWeek } from './time'\nimport { AnimatePresence, motion } from 'motion-v'\nimport { computed, nextTick, ref } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { formatTime, rangesToSlots, slotsToRanges, toMinutes } from './time'\n\nconst props = defineProps<{\n  days: string[]\n  startHour: number\n  endHour: number\n  step: number\n  hour12: boolean\n}>()\n\nconst week = defineModel<AvailabilityWeek>({ required: true })\n\nconst HOUR_HEIGHT = 26\nconst LABEL_W = 48\nconst BLOCK = { type: 'spring', stiffness: 500, damping: 40 } as const\n\nconst origin = computed(() => props.startHour * 60)\nconst count = computed(() => Math.round(((props.endHour - props.startHour) * 60) / props.step))\nconst rowH = computed(() => (HOUR_HEIGHT * props.step) / 60)\nconst slots = computed(() => week.value.map(d => rangesToSlots(d, origin.value, props.step, count.value)))\n\nfunction commit(next: boolean[][]) {\n  week.value = week.value.map((day, i) => {\n    const ranges = slotsToRanges(next[i]!, origin.value, props.step)\n    return { enabled: ranges.length > 0, ranges }\n  })\n}\n\n// ---------------------------------------------------------------------------\n// Pointer painting: drag paints (or erases) a rectangle of slots\n// ---------------------------------------------------------------------------\nconst area = ref<HTMLElement>()\nlet drag: { day: number, slot: number, value: boolean, snapshot: boolean[][] } | null = null\n\nfunction cellAt(e: PointerEvent) {\n  const rect = area.value!.getBoundingClientRect()\n  const colW = (rect.width - LABEL_W) / props.days.length\n  const day = Math.floor((e.clientX - rect.left - LABEL_W) / colW)\n  const slot = Math.floor((e.clientY - rect.top) / rowH.value)\n  return {\n    day: Math.min(props.days.length - 1, Math.max(0, day)),\n    slot: Math.min(count.value - 1, Math.max(0, slot)),\n    inside: day >= 0 && day < props.days.length,\n  }\n}\n\nfunction paint(to: { day: number, slot: number }) {\n  if (!drag)\n    return\n  const next = drag.snapshot.map(col => [...col])\n  const [d0, d1] = [Math.min(drag.day, to.day), Math.max(drag.day, to.day)]\n  const [s0, s1] = [Math.min(drag.slot, to.slot), Math.max(drag.slot, to.slot)]\n  for (let d = d0; d <= d1; d++) {\n    for (let s = s0; s <= s1; s++) next[d]![s] = drag.value\n  }\n  commit(next)\n}\n\nfunction onPointerDown(e: PointerEvent) {\n  if (e.button !== 0)\n    return\n  const cell = cellAt(e)\n  if (!cell.inside)\n    return\n  e.preventDefault()\n  area.value!.setPointerCapture(e.pointerId)\n  const snapshot = slots.value.map(col => [...col])\n  drag = { day: cell.day, slot: cell.slot, value: !snapshot[cell.day]![cell.slot], snapshot }\n  active.value = { day: cell.day, slot: cell.slot }\n  paint(cell)\n}\nfunction onPointerMove(e: PointerEvent) {\n  if (drag)\n    paint(cellAt(e))\n}\nfunction onPointerUp() {\n  drag = null\n}\n\n// ---------------------------------------------------------------------------\n// Keyboard: roving focus over cells, Space / Enter toggles\n// ---------------------------------------------------------------------------\nconst active = ref({ day: 0, slot: Math.max(0, Math.round(((9 - props.startHour) * 60) / props.step)) })\n\nfunction focusCell() {\n  nextTick(() => area.value?.querySelector<HTMLElement>(`[data-cell=\"${active.value.day}-${active.value.slot}\"]`)?.focus())\n}\n\nfunction onKeydown(e: KeyboardEvent) {\n  const { day, slot } = active.value\n  const moves: Record<string, [number, number]> = {\n    ArrowUp: [day, slot - 1],\n    ArrowDown: [day, slot + 1],\n    ArrowLeft: [day - 1, slot],\n    ArrowRight: [day + 1, slot],\n    Home: [day, 0],\n    End: [day, count.value - 1],\n  }\n  if (e.key === ' ' || e.key === 'Enter') {\n    e.preventDefault()\n    const next = slots.value.map(col => [...col])\n    next[day]![slot] = !next[day]![slot]\n    commit(next)\n    return\n  }\n  const move = moves[e.key]\n  if (!move)\n    return\n  e.preventDefault()\n  // Shift + arrows paints the slot you move onto with the current slot's value.\n  if (e.shiftKey) {\n    const value = slots.value[day]![slot]!\n    drag = { day, slot, value, snapshot: slots.value.map(col => [...col]) }\n  }\n  active.value = {\n    day: Math.min(props.days.length - 1, Math.max(0, move[0])),\n    slot: Math.min(count.value - 1, Math.max(0, move[1])),\n  }\n  if (drag) {\n    paint(active.value)\n    drag = null\n  }\n  focusCell()\n}\n\n// ---------------------------------------------------------------------------\n// Rendering helpers\n// ---------------------------------------------------------------------------\nconst rows = computed(() => Array.from({ length: count.value }, (_, i) => origin.value + i * props.step))\nconst blocks = computed(() => week.value.map(day => (day.enabled\n  ? day.ranges\n      .map(r => ({ start: toMinutes(r.start), end: toMinutes(r.end) }))\n      .filter(r => r.end > r.start)\n      .map(r => ({\n        key: r.start,\n        top: ((Math.max(r.start, origin.value) - origin.value) / props.step) * rowH.value,\n        height: ((Math.min(r.end, props.endHour * 60) - Math.max(r.start, origin.value)) / props.step) * rowH.value,\n        from: formatTime(r.start, props.hour12),\n        to: formatTime(r.end, props.hour12),\n      }))\n      .filter(b => b.height > 0)\n  : [])))\nconst columns = computed(() => `${LABEL_W}px repeat(${props.days.length}, minmax(0, 1fr))`)\n</script>\n\n<template>\n  <div role=\"grid\" aria-label=\"Weekly availability\" aria-multiselectable=\"true\" class=\"select-none\">\n    <div role=\"row\" class=\"grid h-8 items-center\" :style=\"{ gridTemplateColumns: columns }\">\n      <span role=\"columnheader\" aria-label=\"Time\" />\n      <span\n        v-for=\"(d, i) in props.days\"\n        :key=\"d\"\n        role=\"columnheader\"\n        :class=\"cn('text-center text-xs font-medium', week[i]?.enabled ? 'text-foreground' : 'text-muted-foreground')\"\n      >\n        {{ d }}\n      </span>\n    </div>\n\n    <div\n      ref=\"area\"\n      class=\"relative touch-none\"\n      @pointerdown=\"onPointerDown\"\n      @pointermove=\"onPointerMove\"\n      @pointerup=\"onPointerUp\"\n      @pointercancel=\"onPointerUp\"\n      @keydown=\"onKeydown\"\n    >\n      <!-- Hour lines + column separators -->\n      <div\n        aria-hidden=\"true\"\n        class=\"pointer-events-none absolute inset-y-0 right-0 grid rounded-lg border bg-muted/30\"\n        :style=\"{\n          left: `${LABEL_W}px`,\n          gridTemplateColumns: `repeat(${props.days.length}, minmax(0, 1fr))`,\n          backgroundImage: `linear-gradient(to bottom, var(--border) 1px, transparent 1px)`,\n          backgroundSize: `100% ${HOUR_HEIGHT}px`,\n        }\"\n      >\n        <div v-for=\"(d, i) in props.days\" :key=\"d\" :class=\"cn('relative', i > 0 && 'border-l')\">\n          <AnimatePresence :initial=\"false\">\n            <motion.div\n              v-for=\"b in blocks[i]\"\n              :key=\"b.key\"\n              class=\"absolute inset-x-1 overflow-hidden rounded-md bg-brand/85 px-1 text-[10px] font-medium leading-tight text-background shadow-xs\"\n              :initial=\"{ opacity: 0, scaleX: 0.6, top: b.top, height: b.height }\"\n              :animate=\"{ opacity: 1, scaleX: 1, top: b.top, height: b.height }\"\n              :exit=\"{ opacity: 0, scaleX: 0.6, transition: { duration: 0.12 } }\"\n              :transition=\"BLOCK\"\n            >\n              <template v-if=\"b.height >= HOUR_HEIGHT * 1.5\">\n                <span class=\"mt-0.5 block truncate tabular-nums\">{{ b.from }}</span>\n                <span class=\"block truncate tabular-nums opacity-75\">{{ b.to }}</span>\n              </template>\n            </motion.div>\n          </AnimatePresence>\n        </div>\n      </div>\n\n      <!-- Cells (transparent, on top for hit-testing and focus rings) -->\n      <div\n        v-for=\"(minutes, s) in rows\"\n        :key=\"minutes\"\n        role=\"row\"\n        class=\"relative z-10 grid\"\n        :style=\"{ gridTemplateColumns: columns, height: `${rowH}px` }\"\n      >\n        <span role=\"rowheader\" class=\"relative text-[10px] text-muted-foreground\">\n          <span v-if=\"minutes % 60 === 0\" class=\"absolute -top-1.5 right-2 tabular-nums\">{{ formatTime(minutes, props.hour12) }}</span>\n          <span v-else class=\"sr-only\">{{ formatTime(minutes, props.hour12) }}</span>\n        </span>\n        <span\n          v-for=\"(d, i) in props.days\"\n          :key=\"d\"\n          role=\"gridcell\"\n          :data-cell=\"`${i}-${s}`\"\n          :aria-selected=\"!!slots[i]?.[s]\"\n          :aria-label=\"`${d} ${formatTime(minutes, props.hour12)}`\"\n          :tabindex=\"active.day === i && active.slot === s ? 0 : -1\"\n          class=\"cursor-cell rounded-[3px] outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset\"\n          @focus=\"active = { day: i, slot: s }\"\n        />\n      </div>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/availability-picker/AvailabilityPicker.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport type { AvailabilityRange, AvailabilityWeek } from './time'\nimport { AnimatePresence, motion } from 'motion-v'\nimport { computed, toRaw, useId } from 'vue'\nimport { cn } from '@/lib/utils'\nimport AvailabilityGrid from './AvailabilityGrid.vue'\nimport { dayMinutes, formatTime, toMinutes, toTime } from './time'\n\nconst props = withDefaults(defineProps<{\n  /** Day labels; the model has one entry per label. */\n  days?: string[]\n  /** First selectable hour (0–23). */\n  startHour?: number\n  /** Last selectable hour (1–24). */\n  endHour?: number\n  /** Minutes between selectable times (15, 30 or 60). */\n  step?: number\n  /** Show times as 9:00am instead of 09:00. */\n  hour12?: boolean\n  /** Range added when a day is switched on. */\n  defaultRange?: AvailabilityRange\n  class?: HTMLAttributes['class']\n}>(), {\n  days: () => ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],\n  startHour: 7,\n  endHour: 21,\n  step: 30,\n  hour12: false,\n  defaultRange: () => ({ start: '09:00', end: '17:00' }),\n})\n\nconst week = defineModel<AvailabilityWeek>({ default: () => [] })\nconst view = defineModel<'list' | 'grid'>('view', { default: 'list' })\n\nconst SPRING = { type: 'spring', stiffness: 420, damping: 36 } as const\nconst uid = useId()\n\n// Make sure there is one entry per day.\nconst days = computed<AvailabilityWeek>(() => props.days.map((_, i) => week.value[i] ?? { enabled: false, ranges: [] }))\n\nfunction setDay(i: number, day: AvailabilityWeek[number]) {\n  week.value = days.value.map((d, j) => (j === i ? day : d))\n}\n\nconst options = computed(() => {\n  const list: { value: string, label: string }[] = []\n  for (let m = props.startHour * 60; m <= props.endHour * 60; m += props.step)\n    list.push({ value: toTime(m), label: formatTime(m, props.hour12) })\n  return list\n})\n\nfunction toggle(i: number) {\n  const day = days.value[i]!\n  setDay(i, { enabled: !day.enabled, ranges: day.ranges.length || day.enabled ? day.ranges : [{ ...props.defaultRange }] })\n}\n\nfunction nextRange(i: number): AvailabilityRange | null {\n  const day = days.value[i]!\n  const limit = props.endHour * 60\n  const last = day.ranges.reduce((max, r) => Math.max(max, toMinutes(r.end)), 0)\n  if (!day.ranges.length)\n    return { ...props.defaultRange }\n  const start = last + 60\n  if (start + props.step > limit)\n    return null\n  return { start: toTime(start), end: toTime(Math.min(limit, start + 60)) }\n}\n\nfunction addRange(i: number) {\n  const range = nextRange(i)\n  if (range)\n    setDay(i, { enabled: true, ranges: [...days.value[i]!.ranges, range] })\n}\n\nfunction removeRange(i: number, r: number) {\n  const ranges = days.value[i]!.ranges.filter((_, j) => j !== r)\n  setDay(i, { enabled: ranges.length > 0, ranges })\n}\n\nfunction updateRange(i: number, r: number, patch: Partial<AvailabilityRange>) {\n  setDay(i, {\n    ...days.value[i]!,\n    ranges: days.value[i]!.ranges.map((range, j) => {\n      if (j !== r)\n        return range\n      const updated = { ...range, ...patch }\n      keys.set(updated, keyOf(range)) // keep the row's identity while editing\n      return updated\n    }),\n  })\n}\n\nfunction rangeError(i: number, r: number) {\n  const ranges = days.value[i]!.ranges\n  const a = ranges[r]!\n  if (toMinutes(a.end) <= toMinutes(a.start))\n    return 'End must be after start'\n  const overlaps = ranges.some((b, j) => j !== r && toMinutes(a.start) < toMinutes(b.end) && toMinutes(b.start) < toMinutes(a.end))\n  return overlaps ? 'Overlaps another range' : ''\n}\n\n// Stable keys for ranges so add/remove animates the right row.\nconst keys = new WeakMap<AvailabilityRange, number>()\nlet seq = 0\nfunction keyOf(range: AvailabilityRange) {\n  const raw = toRaw(range)\n  if (!keys.has(raw))\n    keys.set(raw, ++seq)\n  return keys.get(raw)!\n}\n\nconst totalMinutes = computed(() => days.value.reduce((sum, d) => sum + dayMinutes(d), 0))\nconst totalHours = computed(() => Math.round((totalMinutes.value / 60) * 10) / 10)\nconst activeDays = computed(() => days.value.filter(d => dayMinutes(d) > 0).length)\nconst perDay = computed(() => days.value.map(d => dayMinutes(d)))\nconst maxDay = computed(() => Math.max(60, ...perDay.value))\n\nfunction onViewKey(e: KeyboardEvent) {\n  if (['ArrowLeft', 'ArrowRight'].includes(e.key)) {\n    e.preventDefault()\n    view.value = view.value === 'list' ? 'grid' : 'list'\n    ;(e.currentTarget as HTMLElement).querySelector<HTMLElement>(`[data-view=\"${view.value}\"]`)?.focus()\n  }\n}\n</script>\n\n<template>\n  <div :class=\"cn('@container w-full rounded-2xl border bg-card p-4 text-card-foreground shadow-sm sm:p-5', props.class)\">\n    <!-- Summary + view switch -->\n    <div class=\"flex flex-wrap items-end justify-between gap-3\">\n      <div>\n        <p class=\"m-0 text-xs font-medium text-muted-foreground\">\n          Weekly availability\n        </p>\n        <p class=\"m-0 mt-0.5 flex items-baseline gap-1.5\" aria-live=\"polite\">\n          <span class=\"relative inline-flex overflow-hidden text-2xl font-semibold tabular-nums tracking-tight\">\n            <AnimatePresence mode=\"popLayout\" :initial=\"false\">\n              <motion.span\n                :key=\"totalHours\"\n                :initial=\"{ y: 16, opacity: 0 }\"\n                :animate=\"{ y: 0, opacity: 1 }\"\n                :exit=\"{ y: -16, opacity: 0 }\"\n                :transition=\"SPRING\"\n              >\n                {{ totalHours }}\n              </motion.span>\n            </AnimatePresence>\n          </span>\n          <span class=\"text-sm text-muted-foreground\">h / week across {{ activeDays }} {{ activeDays === 1 ? 'day' : 'days' }}</span>\n        </p>\n      </div>\n      <div class=\"flex items-end gap-3\">\n        <div class=\"hidden h-8 items-end gap-1 sm:flex\" aria-hidden=\"true\">\n          <motion.span\n            v-for=\"(m, i) in perDay\"\n            :key=\"i\"\n            class=\"w-1.5 rounded-full bg-brand\"\n            :animate=\"{ height: `${Math.max(3, (m / maxDay) * 32)}px`, opacity: m ? 1 : 0.25 }\"\n            :transition=\"SPRING\"\n          />\n        </div>\n        <div role=\"tablist\" aria-label=\"View\" class=\"flex gap-1 rounded-lg bg-muted p-1\" @keydown=\"onViewKey\">\n          <button\n            v-for=\"v in (['list', 'grid'] as const)\"\n            :key=\"v\"\n            type=\"button\"\n            role=\"tab\"\n            :data-view=\"v\"\n            :aria-selected=\"view === v\"\n            :tabindex=\"view === v ? 0 : -1\"\n            :class=\"cn('relative rounded-md px-2.5 py-1 text-xs font-medium capitalize outline-none transition-colors focus-visible:ring-[3px] focus-visible:ring-ring/50', view === v ? 'text-foreground' : 'text-muted-foreground hover:text-foreground')\"\n            @click=\"view = v\"\n          >\n            <motion.span\n              v-if=\"view === v\"\n              :layout-id=\"`vx-avail-view-${uid}`\"\n              class=\"absolute inset-0 rounded-md bg-background shadow-sm\"\n              :transition=\"SPRING\"\n            />\n            <span class=\"relative\">{{ v }}</span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"mt-4\">\n      <AnimatePresence mode=\"wait\" :initial=\"false\">\n        <!-- List view -->\n        <motion.ul\n          v-if=\"view === 'list'\"\n          key=\"list\"\n          class=\"m-0 list-none divide-y p-0\"\n          :initial=\"{ opacity: 0, y: 8 }\"\n          :animate=\"{ opacity: 1, y: 0 }\"\n          :exit=\"{ opacity: 0, y: -8 }\"\n          :transition=\"{ duration: 0.18 }\"\n        >\n          <li v-for=\"(day, i) in days\" :key=\"props.days[i]\" class=\"flex flex-wrap items-start gap-x-3 py-2.5 @md:flex-nowrap\">\n            <button\n              type=\"button\"\n              role=\"switch\"\n              :aria-checked=\"day.enabled\"\n              :aria-label=\"`Available on ${props.days[i]}`\"\n              :class=\"cn(\n                'relative mt-1.5 inline-flex h-5 w-9 shrink-0 items-center rounded-full p-0.5 outline-none transition-colors focus-visible:ring-[3px] focus-visible:ring-ring/50',\n                day.enabled ? 'bg-brand' : 'bg-input',\n              )\"\n              @click=\"toggle(i)\"\n            >\n              <motion.span\n                class=\"block size-4 rounded-full bg-background shadow-sm\"\n                :animate=\"{ x: day.enabled ? 16 : 0 }\"\n                :transition=\"{ type: 'spring', stiffness: 700, damping: 30 }\"\n              />\n            </button>\n            <span :class=\"cn('mt-1.5 w-10 shrink-0 text-sm font-medium', !day.enabled && 'text-muted-foreground')\">{{ props.days[i] }}</span>\n\n            <p v-if=\"!day.enabled\" class=\"m-0 mt-1.5 text-sm text-muted-foreground @md:hidden\">\n              Unavailable\n            </p>\n            <!-- Narrow containers: ranges wrap onto their own line under the day -->\n            <div class=\"order-last mt-1 w-full min-w-0 @md:order-none @md:mt-0 @md:w-auto @md:flex-1\">\n              <p v-if=\"!day.enabled\" class=\"m-0 mt-1.5 hidden text-sm text-muted-foreground @md:block\">\n                Unavailable\n              </p>\n              <AnimatePresence :initial=\"false\">\n                <motion.div\n                  v-for=\"(range, r) in (day.enabled ? day.ranges : [])\"\n                  :key=\"keyOf(range)\"\n                  class=\"overflow-hidden\"\n                  :initial=\"{ opacity: 0, height: 0 }\"\n                  :animate=\"{ opacity: 1, height: 'auto' }\"\n                  :exit=\"{ opacity: 0, height: 0 }\"\n                  :transition=\"SPRING\"\n                >\n                  <div class=\"flex items-center gap-2 py-0.5\">\n                    <label class=\"relative\">\n                      <span class=\"sr-only\">{{ props.days[i] }} range {{ r + 1 }} start</span>\n                      <select\n                        :value=\"range.start\"\n                        :aria-invalid=\"!!rangeError(i, r) || undefined\"\n                        class=\"h-8 appearance-none rounded-lg border bg-background py-0 pl-2.5 pr-7 text-sm tabular-nums text-foreground outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive\"\n                        @change=\"updateRange(i, r, { start: ($event.target as HTMLSelectElement).value })\"\n                      >\n                        <option v-for=\"o in options.slice(0, -1)\" :key=\"o.value\" :value=\"o.value\">{{ o.label }}</option>\n                      </select>\n                      <svg class=\"pointer-events-none absolute right-2 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" /></svg>\n                    </label>\n                    <span class=\"text-muted-foreground\" aria-hidden=\"true\">–</span>\n                    <label class=\"relative\">\n                      <span class=\"sr-only\">{{ props.days[i] }} range {{ r + 1 }} end</span>\n                      <select\n                        :value=\"range.end\"\n                        :aria-invalid=\"!!rangeError(i, r) || undefined\"\n                        class=\"h-8 appearance-none rounded-lg border bg-background py-0 pl-2.5 pr-7 text-sm tabular-nums text-foreground outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive\"\n                        @change=\"updateRange(i, r, { end: ($event.target as HTMLSelectElement).value })\"\n                      >\n                        <option v-for=\"o in options.slice(1)\" :key=\"o.value\" :value=\"o.value\">{{ o.label }}</option>\n                      </select>\n                      <svg class=\"pointer-events-none absolute right-2 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" /></svg>\n                    </label>\n                    <button\n                      type=\"button\"\n                      :aria-label=\"`Remove ${props.days[i]} ${formatTime(toMinutes(range.start), props.hour12)} to ${formatTime(toMinutes(range.end), props.hour12)}`\"\n                      class=\"inline-flex size-8 shrink-0 items-center justify-center rounded-lg text-muted-foreground outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50\"\n                      @click=\"removeRange(i, r)\"\n                    >\n                      <svg class=\"size-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\" /></svg>\n                    </button>\n                  </div>\n                  <p v-if=\"rangeError(i, r)\" class=\"m-0 pb-1 text-xs text-destructive\">\n                    {{ rangeError(i, r) }}\n                  </p>\n                </motion.div>\n              </AnimatePresence>\n            </div>\n\n            <button\n              type=\"button\"\n              :aria-label=\"`Add a time range on ${props.days[i]}`\"\n              :disabled=\"!!day.ranges.length && day.enabled && !nextRange(i)\"\n              class=\"ml-auto mt-0.5 inline-flex size-8 shrink-0 items-center justify-center rounded-lg text-muted-foreground outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-40\"\n              @click=\"day.enabled ? addRange(i) : toggle(i)\"\n            >\n              <svg class=\"size-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\" /></svg>\n            </button>\n          </li>\n        </motion.ul>\n\n        <!-- Grid view -->\n        <motion.div\n          v-else\n          key=\"grid\"\n          :initial=\"{ opacity: 0, y: 8 }\"\n          :animate=\"{ opacity: 1, y: 0 }\"\n          :exit=\"{ opacity: 0, y: -8 }\"\n          :transition=\"{ duration: 0.18 }\"\n        >\n          <AvailabilityGrid\n            :model-value=\"days\"\n            :days=\"props.days\"\n            :start-hour=\"props.startHour\"\n            :end-hour=\"props.endHour\"\n            :step=\"props.step\"\n            :hour12=\"props.hour12\"\n            @update:model-value=\"week = $event\"\n          />\n          <p class=\"m-0 mt-3 text-xs text-muted-foreground\">\n            Drag to paint availability, drag over painted time to erase. Arrow keys move, Space toggles, Shift + arrows paints.\n          </p>\n        </motion.div>\n      </AnimatePresence>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/availability-picker/index.ts",
      "content": "export { default as AvailabilityPicker } from './AvailabilityPicker.vue'\nexport { dayMinutes } from './time'\nexport type { AvailabilityDay, AvailabilityRange, AvailabilityWeek } from './time'\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/availability-picker/time.ts",
      "content": "export interface AvailabilityRange {\n  /** \"HH:MM\", 24-hour */\n  start: string\n  /** \"HH:MM\", 24-hour */\n  end: string\n}\n\nexport interface AvailabilityDay {\n  enabled: boolean\n  ranges: AvailabilityRange[]\n}\n\n/** One entry per day, in the same order as the `days` labels. */\nexport type AvailabilityWeek = AvailabilityDay[]\n\nexport function toMinutes(time: string) {\n  const [h = 0, m = 0] = time.split(':').map(Number)\n  return h * 60 + m\n}\n\nexport function toTime(minutes: number) {\n  const h = Math.floor(minutes / 60)\n  const m = minutes % 60\n  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`\n}\n\nexport function formatTime(minutes: number, hour12: boolean) {\n  const h = Math.floor(minutes / 60)\n  const m = String(minutes % 60).padStart(2, '0')\n  if (!hour12)\n    return `${String(h).padStart(2, '0')}:${m}`\n  const suffix = h >= 12 && h < 24 ? 'pm' : 'am'\n  return `${h % 12 || 12}:${m}${suffix}`\n}\n\n/** Valid minutes in a day's ranges (overlaps counted once). */\nexport function dayMinutes(day: AvailabilityDay) {\n  if (!day.enabled)\n    return 0\n  const spans = day.ranges\n    .map(r => [toMinutes(r.start), toMinutes(r.end)] as const)\n    .filter(([s, e]) => e > s)\n    .sort((a, b) => a[0] - b[0])\n  let total = 0\n  let cursor = -1\n  for (const [s, e] of spans) {\n    const from = Math.max(s, cursor)\n    if (e > from)\n      total += e - from\n    cursor = Math.max(cursor, e)\n  }\n  return total\n}\n\n/** Slot booleans for a day, `count` slots of `step` minutes starting at `origin`. */\nexport function rangesToSlots(day: AvailabilityDay, origin: number, step: number, count: number) {\n  const slots = Array.from<boolean>({ length: count }).fill(false)\n  if (!day.enabled)\n    return slots\n  for (const r of day.ranges) {\n    const a = Math.max(0, Math.floor((toMinutes(r.start) - origin) / step))\n    const b = Math.min(count, Math.ceil((toMinutes(r.end) - origin) / step))\n    for (let i = a; i < b; i++) slots[i] = true\n  }\n  return slots\n}\n\nexport function slotsToRanges(slots: boolean[], origin: number, step: number): AvailabilityRange[] {\n  const ranges: AvailabilityRange[] = []\n  let runStart = -1\n  slots.forEach((on, i) => {\n    if (on && runStart < 0)\n      runStart = i\n    if ((!on || i === slots.length - 1) && runStart >= 0) {\n      const end = on ? i + 1 : i\n      ranges.push({ start: toTime(origin + runStart * step), end: toTime(origin + end * step) })\n      runStart = -1\n    }\n  })\n  return ranges\n}\n",
      "type": "registry:ui"
    }
