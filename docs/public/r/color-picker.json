    {
      "path": "registry/ui/color-picker/ColorPickerPopover.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport type { ColorFormat } from './color'\nimport { AnimatePresence, motion, useDomRef } from 'motion-v'\nimport { computed, nextTick, onBeforeUnmount, ref, useId, watch } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { clamp } from './color'\nimport ColorPicker from './ColorPicker.vue'\n\n// The root renders a button plus a teleported panel, so forward attrs (id, data-*, …) to the button.\ndefineOptions({ inheritAttrs: false })\n\nconst props = withDefaults(defineProps<{\n  /** Accessible name of the trigger and the popover. */\n  label?: string\n  /** Show the hex value next to the swatch in the trigger. */\n  showValue?: boolean\n  /** Horizontal alignment of the popover relative to the trigger. */\n  align?: 'start' | 'center' | 'end'\n  /** Forwarded to `ColorPicker`. */\n  alpha?: boolean\n  /** Forwarded to `ColorPicker`. */\n  eyedropper?: boolean\n  /** Forwarded to `ColorPicker`. */\n  recentLimit?: number\n  disabled?: boolean\n  /** Classes for the trigger button. */\n  class?: HTMLAttributes['class']\n  /** Classes for the picker inside the popover. */\n  contentClass?: HTMLAttributes['class']\n}>(), {\n  label: 'Pick a color',\n  showValue: true,\n  align: 'start',\n  eyedropper: true,\n  recentLimit: 7,\n})\n\nconst emit = defineEmits<{ change: [value: string] }>()\n\nconst model = defineModel<string>({ default: '#6366f1' })\nconst open = defineModel<boolean>('open', { default: false })\n// Kept here (not in the picker) so history and format survive the picker unmounting on close.\nconst recent = defineModel<string[]>('recent', { default: () => [] })\nconst format = defineModel<ColorFormat>('format', { default: 'hex' })\n\nconst panelId = `vx-color-popover-${useId()}`\nconst trigger = ref<HTMLButtonElement>()\nconst panel = useDomRef()\n\nconst spring = { type: 'spring', stiffness: 520, damping: 34 } as const\nconst GAP = 8\n\nconst pos = ref({ top: 0, left: 0, originX: 0, above: false })\nconst origin = computed(() => `${pos.value.originX}px ${pos.value.above ? '100%' : '0%'}`)\n\nconst CHECKER = {\n  backgroundColor: 'var(--color-background)',\n  backgroundImage: 'repeating-conic-gradient(var(--color-border) 0 25%, transparent 0 50%)',\n  backgroundSize: '8px 8px',\n}\n\n/** Places the popover under the trigger (or above it when there's no room) and clamps it to the viewport. */\nfunction place() {\n  const t = trigger.value\n  if (!t)\n    return\n  const el = panel.value as HTMLElement | null\n  // offsetWidth/Height ignore the scale transform, so measuring mid-animation is fine.\n  const w = el?.offsetWidth ?? 288\n  const h = el?.offsetHeight ?? 380\n  const r = t.getBoundingClientRect()\n  const above = r.bottom + GAP + h > window.innerHeight && r.top - GAP - h > 0\n  const ideal = props.align === 'start' ? r.left : props.align === 'end' ? r.right - w : r.left + r.width / 2 - w / 2\n  const left = clamp(ideal, GAP, Math.max(GAP, window.innerWidth - w - GAP))\n  pos.value = {\n    top: above ? r.top - GAP - h : r.bottom + GAP,\n    left,\n    originX: clamp(r.left + r.width / 2 - left, 0, w),\n    above,\n  }\n}\n\nfunction close(refocus = false) {\n  open.value = false\n  if (refocus)\n    trigger.value?.focus({ preventScroll: true })\n}\n\nfunction onDocPointerDown(e: PointerEvent) {\n  const target = e.target as Node\n  const el = panel.value as HTMLElement | null\n  if (el?.contains(target) || trigger.value?.contains(target))\n    return\n  close()\n}\n\nfunction onDocKeydown(e: KeyboardEvent) {\n  if (e.key === 'Escape') {\n    e.preventDefault()\n    close(true)\n  }\n}\n\nfunction listen(on: boolean) {\n  if (on) {\n    document.addEventListener('pointerdown', onDocPointerDown, true)\n    document.addEventListener('keydown', onDocKeydown)\n    window.addEventListener('resize', place)\n    window.addEventListener('scroll', place, true)\n  }\n  else {\n    document.removeEventListener('pointerdown', onDocPointerDown, true)\n    document.removeEventListener('keydown', onDocKeydown)\n    window.removeEventListener('resize', place)\n    window.removeEventListener('scroll', place, true)\n  }\n}\n\nwatch(open, async (isOpen) => {\n  if (typeof document === 'undefined')\n    return\n  listen(isOpen)\n  if (!isOpen)\n    return\n  place()\n  await nextTick()\n  place()\n  ;((panel.value as HTMLElement | null)?.querySelector('[role=\"slider\"]') as HTMLElement | null)?.focus({ preventScroll: true })\n}, { immediate: true })\n\nonBeforeUnmount(() => {\n  if (typeof document !== 'undefined')\n    listen(false)\n})\n</script>\n\n<template>\n  <button\n    v-bind=\"$attrs\"\n    ref=\"trigger\"\n    type=\"button\"\n    aria-haspopup=\"dialog\"\n    :aria-expanded=\"open\"\n    :aria-controls=\"open ? panelId : undefined\"\n    :aria-label=\"`${props.label}: ${model}`\"\n    :disabled=\"props.disabled\"\n    :class=\"cn(\n      'inline-flex h-9 items-center gap-2 rounded-lg border bg-background pl-1.5 text-sm shadow-xs outline-none transition-colors hover:bg-accent focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50',\n      props.showValue ? 'pr-3' : 'pr-1.5',\n      props.class,\n    )\"\n    @click=\"open = !open\"\n  >\n    <span class=\"relative size-6 shrink-0 overflow-hidden rounded-md\" :style=\"CHECKER\">\n      <span class=\"absolute inset-0\" :style=\"{ backgroundColor: model }\" />\n      <span aria-hidden=\"true\" class=\"absolute inset-0 rounded-md ring-1 ring-inset ring-foreground/10\" />\n    </span>\n    <span v-if=\"props.showValue\" class=\"font-mono text-xs uppercase tabular-nums\">{{ model }}</span>\n  </button>\n\n  <Teleport to=\"body\">\n    <AnimatePresence>\n      <motion.div\n        v-if=\"open\"\n        :id=\"panelId\"\n        key=\"panel\"\n        ref=\"panel\"\n        role=\"dialog\"\n        :aria-label=\"props.label\"\n        class=\"fixed z-50\"\n        :style=\"{ top: `${pos.top}px`, left: `${pos.left}px`, transformOrigin: origin }\"\n        :initial=\"{ opacity: 0, scale: 0.6, y: pos.above ? 8 : -8 }\"\n        :animate=\"{ opacity: 1, scale: 1, y: 0 }\"\n        :exit=\"{ opacity: 0, scale: 0.85, y: pos.above ? 6 : -6, transition: { duration: 0.15 } }\"\n        :transition=\"spring\"\n      >\n        <ColorPicker\n          v-model=\"model\"\n          v-model:recent=\"recent\"\n          v-model:format=\"format\"\n          :alpha=\"props.alpha\"\n          :eyedropper=\"props.eyedropper\"\n          :recent-limit=\"props.recentLimit\"\n          :class=\"cn('bg-popover text-popover-foreground shadow-xl', props.contentClass)\"\n          @change=\"emit('change', $event)\"\n        />\n      </motion.div>\n    </AnimatePresence>\n  </Teleport>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/color-picker/color.ts",
      "content": "// Tiny, dependency-free color math for the color picker.\n//\n// Conventions used everywhere in this file:\n//   r, g, b  → 0–255 (integers once rounded)\n//   h        → 0–360 degrees\n//   s, v, l  → 0–100 percent\n//   a        → 0–1\n\nexport interface Rgba { r: number, g: number, b: number, a: number }\nexport interface Hsva { h: number, s: number, v: number, a: number }\nexport interface Hsla { h: number, s: number, l: number, a: number }\n\nexport type ColorFormat = 'hex' | 'rgb' | 'hsl'\n\nexport const clamp = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n))\n\nconst toHexByte = (n: number) => Math.round(clamp(n, 0, 255)).toString(16).padStart(2, '0')\n\n/** Parses `#rgb`, `#rgba`, `#rrggbb` or `#rrggbbaa` (the `#` is optional). Returns `null` if invalid. */\nexport function parseHex(input: string): Rgba | null {\n  let hex = input.trim().replace(/^#/, '')\n  if (!/^(?:[\\da-f]{3,4}|[\\da-f]{6}|[\\da-f]{8})$/i.test(hex))\n    return null\n  if (hex.length <= 4)\n    hex = [...hex].map(c => c + c).join('')\n  const n = (i: number) => Number.parseInt(hex.slice(i, i + 2), 16)\n  return { r: n(0), g: n(2), b: n(4), a: hex.length === 8 ? n(6) / 255 : 1 }\n}\n\n/**\n * Lenient parser for pasted values: any hex form, `rgb()/rgba()` or `hsl()/hsla()`\n * (comma or space separated, optional `/ alpha`). Returns `null` if it can't make sense of it.\n */\nexport function parseColor(input: string): Rgba | null {\n  const text = input.trim().toLowerCase()\n  const fn = /^(rgba?|hsla?)\\(([^)]*)\\)$/.exec(text)\n  if (!fn)\n    return parseHex(text)\n  const parts = fn[2]!.split(/[\\s,/]+/).filter(Boolean)\n  if (parts.length < 3 || parts.length > 4)\n    return null\n  const num = (p: string) => Number.parseFloat(p)\n  const nums = parts.map(num)\n  if (nums.some(Number.isNaN))\n    return null\n  const alphaPart = parts[3]\n  const a = alphaPart === undefined ? 1 : clamp(alphaPart.endsWith('%') ? num(alphaPart) / 100 : num(alphaPart), 0, 1)\n  if (fn[1]!.startsWith('rgb')) {\n    const ch = (p: string) => clamp(p.endsWith('%') ? num(p) * 2.55 : num(p), 0, 255)\n    return { r: ch(parts[0]!), g: ch(parts[1]!), b: ch(parts[2]!), a }\n  }\n  return hslToRgb({ h: ((nums[0]! % 360) + 360) % 360, s: clamp(nums[1]!, 0, 100), l: clamp(nums[2]!, 0, 100), a })\n}\n\n/** `#rrggbb`, or `#rrggbbaa` when `alpha` is true and the color isn't fully opaque. */\nexport function toHex({ r, g, b, a }: Rgba, alpha = false): string {\n  const base = `#${toHexByte(r)}${toHexByte(g)}${toHexByte(b)}`\n  return alpha && a < 1 ? base + toHexByte(a * 255) : base\n}\n\nexport function hsvToRgb({ h, s, v, a }: Hsva): Rgba {\n  const sat = s / 100\n  const val = v / 100\n  // f(n) walks the hue wheel once per channel (n = 5 → red, 3 → green, 1 → blue).\n  const f = (n: number) => {\n    const k = (n + h / 60) % 6\n    return val - val * sat * Math.max(0, Math.min(k, 4 - k, 1))\n  }\n  return { r: f(5) * 255, g: f(3) * 255, b: f(1) * 255, a }\n}\n\n/** Hue of an rgb triple (0–360); `fallback` is returned for greys, where hue is undefined. */\nfunction hueOf(r: number, g: number, b: number, max: number, delta: number, fallback: number) {\n  if (delta === 0)\n    return fallback\n  let h: number\n  if (max === r)\n    h = ((g - b) / delta) % 6\n  else if (max === g)\n    h = (b - r) / delta + 2\n  else\n    h = (r - g) / delta + 4\n  return (h * 60 + 360) % 360\n}\n\n/** `hue` is kept for greys (s = 0) so a picker's hue slider doesn't jump back to red. */\nexport function rgbToHsv({ r, g, b, a }: Rgba, hue = 0): Hsva {\n  const [rn, gn, bn] = [r / 255, g / 255, b / 255]\n  const max = Math.max(rn, gn, bn)\n  const delta = max - Math.min(rn, gn, bn)\n  return {\n    h: hueOf(rn, gn, bn, max, delta, hue),\n    s: max === 0 ? 0 : (delta / max) * 100,\n    v: max * 100,\n    a,\n  }\n}\n\nexport function rgbToHsl({ r, g, b, a }: Rgba, hue = 0): Hsla {\n  const [rn, gn, bn] = [r / 255, g / 255, b / 255]\n  const max = Math.max(rn, gn, bn)\n  const min = Math.min(rn, gn, bn)\n  const delta = max - min\n  const l = (max + min) / 2\n  return {\n    h: hueOf(rn, gn, bn, max, delta, hue),\n    s: delta === 0 ? 0 : (delta / (1 - Math.abs(2 * l - 1))) * 100,\n    l: l * 100,\n    a,\n  }\n}\n\nexport function hslToRgb({ h, s, l, a }: Hsla): Rgba {\n  const sat = s / 100\n  const lig = l / 100\n  const k = sat * Math.min(lig, 1 - lig)\n  const f = (n: number) => {\n    const m = (n + h / 30) % 12\n    return lig - k * Math.max(-1, Math.min(m - 3, 9 - m, 1))\n  }\n  return { r: f(0) * 255, g: f(8) * 255, b: f(4) * 255, a }\n}\n\n// HSV ↔ HSL directly, so editing in HSL never loses the hue through an rgb round-trip.\nexport function hsvToHsl({ h, s, v, a }: Hsva): Hsla {\n  const sv = s / 100\n  const vv = v / 100\n  const l = vv * (1 - sv / 2)\n  const sl = l === 0 || l === 1 ? 0 : (vv - l) / Math.min(l, 1 - l)\n  return { h, s: sl * 100, l: l * 100, a }\n}\n\nexport function hslToHsv({ h, s, l, a }: Hsla): Hsva {\n  const sl = s / 100\n  const ll = l / 100\n  const v = ll + sl * Math.min(ll, 1 - ll)\n  return { h, s: v === 0 ? 0 : 2 * (1 - ll / v) * 100, v: v * 100, a }\n}\n\n/** Relative luminance (0–1) — handy for picking a readable foreground on top of a color. */\nexport function luminance({ r, g, b }: Rgba): number {\n  const lin = (c: number) => {\n    const n = c / 255\n    return n <= 0.03928 ? n / 12.92 : ((n + 0.055) / 1.055) ** 2.4\n  }\n  return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)\n}\n",
      "type": "registry:ui"
    },
