{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "citations",
  "title": "Citations",
  "description": "Numbered citation chips with hover cards, linked to a sources list that lights up the cited source.",
  "dependencies": [
    "motion-v"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/ui/citations/CitationChip.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport { AnimatePresence, motion } from 'motion-v'\nimport { computed, inject, onBeforeUnmount, ref, watch } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { CITATIONS_KEY, sourceDomain } from './context'\nimport SourceIcon from './SourceIcon.vue'\n\nconst props = defineProps<{\n  /** 1-based number of the source in the parent `<Citations>`' `sources`. */\n  n: number\n  class?: HTMLAttributes['class']\n}>()\n\n// The chip and its teleported card are two roots: forward extra attributes to the chip.\ndefineOptions({ inheritAttrs: false })\n\nconst ctx = inject(CITATIONS_KEY, null)\nconst source = computed(() => ctx?.sources.value[props.n - 1])\nconst domain = computed(() => (source.value ? sourceDomain(source.value) : ''))\nconst cardId = computed(() => `${ctx?.uid ?? 'vx-cite'}-card-${props.n}`)\n\nconst el = ref<HTMLElement>()\nconst open = ref(false)\nconst pos = ref<{ left: number, top?: number, bottom?: number, above: boolean }>({ left: 0, above: true })\nlet timer: ReturnType<typeof setTimeout> | undefined\n\nconst CARD_WIDTH = 288\n\nfunction place() {\n  if (!el.value)\n    return\n  const r = el.value.getBoundingClientRect()\n  const left = Math.min(Math.max(8, r.left + r.width / 2 - CARD_WIDTH / 2), window.innerWidth - CARD_WIDTH - 8)\n  const above = r.top > 200\n  pos.value = above\n    ? { left, bottom: window.innerHeight - r.top + 8, above }\n    : { left, top: r.bottom + 8, above }\n}\n\nfunction show(delay = 90) {\n  clearTimeout(timer)\n  if (ctx)\n    ctx.active.value = props.n\n  timer = setTimeout(() => {\n    place()\n    open.value = true\n  }, delay)\n}\n\nfunction hide(delay = 120) {\n  clearTimeout(timer)\n  timer = setTimeout(() => {\n    open.value = false\n    if (ctx?.active.value === props.n)\n      ctx.active.value = null\n  }, delay)\n}\n\nconst close = () => hide(0)\nwatch(open, (isOpen) => {\n  if (typeof window === 'undefined')\n    return\n  if (isOpen)\n    window.addEventListener('scroll', close, { passive: true, capture: true })\n  else\n    window.removeEventListener('scroll', close, { capture: true })\n})\nonBeforeUnmount(() => {\n  clearTimeout(timer)\n  if (typeof window !== 'undefined')\n    window.removeEventListener('scroll', close, { capture: true })\n})\n\nconst highlighted = computed(() => open.value || ctx?.active.value === props.n)\n</script>\n\n<template>\n  <component\n    :is=\"source?.url ? 'a' : 'button'\"\n    v-bind=\"$attrs\"\n    ref=\"el\"\n    :href=\"source?.url\"\n    :target=\"source?.url ? '_blank' : undefined\"\n    :rel=\"source?.url ? 'noopener noreferrer' : undefined\"\n    :type=\"source?.url ? undefined : 'button'\"\n    :aria-label=\"source ? `Source ${props.n}: ${source.title}` : `Source ${props.n}`\"\n    :aria-describedby=\"open ? cardId : undefined\"\n    :class=\"cn(\n      'relative -top-px mx-0.5 inline-flex h-[1.4em] min-w-[1.4em] items-center justify-center rounded-md px-1 align-middle text-[0.7rem] font-semibold tabular-nums leading-none no-underline ring-1 outline-none transition-[color,background-color,box-shadow,translate] duration-200 focus-visible:ring-[3px] focus-visible:ring-ring/50',\n      highlighted\n        ? '-translate-y-px bg-brand/15 ring-brand/50'\n        : 'bg-muted ring-border',\n      props.class,\n    )\"\n    @pointerenter=\"show()\"\n    @pointerleave=\"hide()\"\n    @focus=\"show(0)\"\n    @blur=\"hide(0)\"\n    @keydown.esc=\"close\"\n  >\n    <!-- colour on an inner span so global `a:hover` styles can't override it -->\n    <span :class=\"highlighted ? 'text-foreground' : 'text-muted-foreground'\">{{ props.n }}</span>\n  </component>\n\n  <Teleport to=\"body\">\n    <AnimatePresence>\n      <motion.div\n        v-if=\"open && source\"\n        :id=\"cardId\"\n        key=\"card\"\n        role=\"tooltip\"\n        class=\"fixed z-[100] flex w-72 flex-col gap-1.5 rounded-xl border bg-popover p-3.5 text-left text-popover-foreground shadow-xl\"\n        :style=\"{ left: `${pos.left}px`, top: pos.top !== undefined ? `${pos.top}px` : undefined, bottom: pos.bottom !== undefined ? `${pos.bottom}px` : undefined }\"\n        :initial=\"{ opacity: 0, y: pos.above ? 6 : -6, scale: 0.97, filter: 'blur(4px)' }\"\n        :animate=\"{ opacity: 1, y: 0, scale: 1, filter: 'blur(0px)' }\"\n        :exit=\"{ opacity: 0, y: pos.above ? 4 : -4, scale: 0.98, filter: 'blur(2px)', transition: { duration: 0.12 } }\"\n        :transition=\"{ type: 'spring', stiffness: 520, damping: 32, filter: { duration: 0.2, ease: 'easeOut' } }\"\n        @pointerenter=\"show(0)\"\n        @pointerleave=\"hide()\"\n      >\n        <span class=\"flex items-center gap-2 text-xs text-muted-foreground\">\n          <SourceIcon :source=\"source\" :n=\"props.n\" />\n          <span class=\"min-w-0 flex-1 truncate\">{{ domain }}</span>\n          <span class=\"rounded bg-muted px-1.5 py-px text-[10px] font-semibold tabular-nums\">{{ props.n }}</span>\n        </span>\n        <span class=\"line-clamp-2 text-sm font-medium leading-snug\">{{ source.title }}</span>\n        <span v-if=\"source.snippet\" class=\"line-clamp-3 text-xs leading-5 text-muted-foreground\">{{ source.snippet }}</span>\n      </motion.div>\n    </AnimatePresence>\n  </Teleport>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/citations/Citations.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport type { CitationSource } from './context'\nimport { motion } from 'motion-v'\nimport { computed, provide, ref, toRef, useId } from 'vue'\nimport { cn } from '@/lib/utils'\nimport CitationChip from './CitationChip.vue'\nimport { CITATIONS_KEY, sourceDomain } from './context'\nimport SourceIcon from './SourceIcon.vue'\n\nconst props = withDefaults(defineProps<{\n  sources: CitationSource[]\n  /** Text with `[1]`-style markers. Ignored when the default slot is used. */\n  text?: string\n  /** Don't render the sources list. */\n  hideSources?: boolean\n  /** Heading of the sources list. */\n  sourcesLabel?: string\n  class?: HTMLAttributes['class']\n}>(), {\n  text: '',\n  hideSources: false,\n  sourcesLabel: 'Sources',\n})\n\nconst uid = `vx-cite-${useId()}`\nconst active = ref<number | null>(null)\nprovide(CITATIONS_KEY, { sources: toRef(props, 'sources'), active, uid })\n\n// \"Prices rose 4% [1][3].\" → text, chip 1, chip 3, text\nconst parts = computed(() =>\n  props.text.split(/(\\[\\d+\\])/).filter(Boolean).map((part) => {\n    const m = /^\\[(\\d+)\\]$/.exec(part)\n    return m && Number(m[1]) <= props.sources.length ? { n: Number(m[1]) } : { text: part }\n  }),\n)\n\nconst spring = { type: 'spring', stiffness: 500, damping: 38 } as const\n</script>\n\n<template>\n  <div :class=\"cn('flex flex-col gap-4', props.class)\">\n    <div class=\"text-sm leading-7 text-foreground/90\">\n      <slot>\n        <p class=\"m-0\">\n          <template v-for=\"(part, i) in parts\" :key=\"i\">\n            <CitationChip v-if=\"'n' in part\" :n=\"part.n!\" />\n            <template v-else>\n              {{ part.text }}\n            </template>\n          </template>\n        </p>\n      </slot>\n    </div>\n\n    <section v-if=\"!props.hideSources && props.sources.length\" :aria-labelledby=\"`${uid}-heading`\">\n      <h4 :id=\"`${uid}-heading`\" class=\"m-0 mb-1.5 text-xs font-medium text-muted-foreground\">\n        {{ props.sourcesLabel }}\n      </h4>\n      <ol class=\"m-0 grid list-none gap-1 p-0 sm:grid-cols-2\" @pointerleave=\"active = null\">\n        <li v-for=\"(source, i) in props.sources\" :key=\"i\" class=\"relative min-w-0\">\n          <motion.span\n            v-if=\"active === i + 1\"\n            :layout-id=\"`${uid}-highlight`\"\n            aria-hidden=\"true\"\n            class=\"absolute inset-0 rounded-lg bg-muted ring-1 ring-border\"\n            :transition=\"spring\"\n          />\n          <component\n            :is=\"source.url ? 'a' : 'div'\"\n            :href=\"source.url\"\n            :target=\"source.url ? '_blank' : undefined\"\n            :rel=\"source.url ? 'noopener noreferrer' : undefined\"\n            class=\"relative flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-foreground no-underline outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50\"\n            @pointerenter=\"active = i + 1\"\n            @focus=\"active = i + 1\"\n            @blur=\"active = null\"\n          >\n            <span class=\"w-3 shrink-0 text-center text-[11px] font-semibold tabular-nums text-muted-foreground\">{{ i + 1 }}</span>\n            <SourceIcon :source=\"source\" :n=\"i + 1\" />\n            <span class=\"flex min-w-0 flex-1 flex-col\">\n              <span class=\"truncate text-[13px] font-medium leading-5 text-foreground\">{{ source.title }}</span>\n              <span class=\"truncate text-xs leading-4 text-muted-foreground\">{{ sourceDomain(source) }}</span>\n            </span>\n          </component>\n        </li>\n      </ol>\n    </section>\n  </div>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/citations/SourceIcon.vue",
      "content": "<script setup lang=\"ts\">\nimport type { CitationSource } from './context'\nimport { computed, ref } from 'vue'\nimport { cn } from '@/lib/utils'\nimport { sourceDomain } from './context'\n\nconst props = defineProps<{\n  source: CitationSource\n  /** 1-based index, picks the fallback colour. */\n  n: number\n}>()\n\nconst broken = ref(false)\nconst letter = computed(() => (sourceDomain(props.source) || props.source.title).charAt(0).toUpperCase())\nconst tones = ['bg-chart-1', 'bg-chart-2', 'bg-chart-3', 'bg-chart-4', 'bg-chart-5']\n</script>\n\n<template>\n  <img\n    v-if=\"props.source.favicon && !broken\"\n    :src=\"props.source.favicon\"\n    alt=\"\"\n    class=\"size-4 shrink-0 rounded-sm\"\n    @error=\"broken = true\"\n  >\n  <span\n    v-else\n    aria-hidden=\"true\"\n    :class=\"cn('flex size-4 shrink-0 items-center justify-center rounded-sm text-[9px] font-bold leading-none text-background', tones[(props.n - 1) % tones.length])\"\n  >{{ letter }}</span>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/citations/context.ts",
      "content": "import type { InjectionKey, Ref } from 'vue'\n\nexport interface CitationSource {\n  title: string\n  url?: string\n  /** A short excerpt shown in the hover card. */\n  snippet?: string\n  /** Favicon URL. Falls back to the domain's first letter. */\n  favicon?: string\n  /** Display domain. Derived from `url` when omitted. */\n  domain?: string\n}\n\nexport interface CitationsContext {\n  sources: Ref<CitationSource[]>\n  /** 1-based number of the citation currently hovered / focused, in chips or the list. */\n  active: Ref<number | null>\n  uid: string\n}\n\nexport const CITATIONS_KEY: InjectionKey<CitationsContext> = Symbol('vx-citations')\n\nexport function sourceDomain(source: CitationSource) {\n  if (source.domain)\n    return source.domain\n  try {\n    return new URL(source.url ?? '').hostname.replace(/^www\\./, '')\n  }\n  catch {\n    return ''\n  }\n}\n",
      "type": "registry:ui"
    },
    {
      "path": "registry/ui/citations/index.ts",
      "content": "export { default as CitationChip } from './CitationChip.vue'\nexport { default as Citations } from './Citations.vue'\nexport type { CitationSource } from './context'\n",
      "type": "registry:ui"
    }
  ],
  "categories": [
    "ai",
    "ai"
  ],
  "type": "registry:ui"
}
